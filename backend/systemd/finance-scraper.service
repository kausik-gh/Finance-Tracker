[Unit]
Description=Personal Finance Gmail scraper
After=network-online.target finance-backend.service
Wants=network-online.target

[Service]
Type=simple
User=anassyed
Group=anassyed
WorkingDirectory=/home/anassyed/finance-backend
EnvironmentFile=/home/anassyed/finance-backend/.env
ExecStart=/home/anassyed/finance-backend/venv/bin/python scraper_worker.py
Restart=always
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/home/anassyed/finance-backend/logs

[Install]
WantedBy=multi-user.target
