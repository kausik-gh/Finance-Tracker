[Unit]
Description=Personal Finance FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=anassyed
Group=anassyed
WorkingDirectory=/home/anassyed/finance-backend
EnvironmentFile=/home/anassyed/finance-backend/.env
ExecStart=/home/anassyed/finance-backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8010
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/home/anassyed/finance-backend/logs

[Install]
WantedBy=multi-user.target
